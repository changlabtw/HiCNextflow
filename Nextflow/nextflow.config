/* nextflow.config */
env {
    PATH = "/opt/apps/singularity-3.8.7/bin:\$PATH"
}

singularity {
    enabled    = true
    autoMounts = true
}

profiles {
    local {
        process {
            executor = 'local'
            
            // 【全域預設值】
            // 建議不要設到全滿，保留 2-4 核與部分記憶體給系統與硬碟 I/O
            cpus     = 4
            memory   = '16 GB'

            // 1. BWA 比對 (吃滿 CPU 算力)
            withName: 'ALIGN_BWA' {   cpus   = 64  ;  memory = '120 GB'   }
            
            // 2. bin3C 叢集 (中度資源)
            withName: 'RUN_BIN3C' {   cpus   = 16  ;  memory = '20 GB'   }
            
            // 3. HiC-Pro 過濾 (主要吃單核與排序記憶體)
            withName: 'RUN_HICPRO' {   cpus   = 16  ;  memory = '30 GB'   }
            
            // 4. Juicer Pre 轉檔 (文字排序極吃記憶體)
            withName: 'RUN_JUICER_PRE' {   cpus   = 32  ;  memory = '140 GB'   }
            
            // 5. Arrowhead 找 TAD (純 CPU 矩陣計算)
            withName: 'RUN_ARROWHEAD' {   cpus   = 32  ;  memory = '60 GB'   }
            
            // 6. HiCCUPS 找 Loop (★ 單機版唯一啟用 GPU 穿透的任務 ★)
            withName: 'RUN_HICCUPS' {
                containerOptions = '--nv' // 關鍵：單機下必須穿透給 Singularity 容器存取實體 GPU
                cpus             = 32
                memory           = '60 GB'
            }
        }
    }

    // 專為 HPC SLURM 叢集設計的 Profile
    hpc_slurm {
        process {
            executor = 'slurm'
            queue    = 'cputest' // 預設佇列
            
            // 全域預設基礎資源
            cpus     = 4
            memory   = '16 GB'
            time     = '4h'
            
            // 1. BWA 比對 (高 CPU, 高記憶體)
            withName: 'ALIGN_BWA' {   cpus   = 32 ; memory = '90 GB' ; time   = '24h'   }
            
            // 2. bin3C 叢集 (中度資源)
            withName: 'RUN_BIN3C' {   cpus   = 16 ; memory = '40 GB' ; time   = '12h'   }
            
            // 3. HiC-Pro 過濾 (高 CPU 排序需足夠記憶體)
            withName: 'RUN_HICPRO' {   cpus   = 24 ; memory = '60 GB' ; time   = '12h'   }
            
            // 4. Juicer Pre 轉檔 (極吃記憶體排序)
            withName: 'RUN_JUICER_PRE' {   cpus   = 32 ; memory = '120 GB' ; time   = '12h'   }
            
            // 5. Arrowhead 找 TAD (純 CPU 矩陣計算)
            withName: 'RUN_ARROWHEAD' {   cpus   = 8 ; memory = '32 GB' ; time   = '6h'   }
            
            // 6. HiCCUPS 找 Loop (★ 唯一真正需要 GPU 資源的任務 ★)
            withName: 'RUN_HICCUPS' {
                queue            = 'cputest' // 確保此佇列有 GPU 節點，或改為您的 gpu 佇列
                containerOptions = '--nv'    // 啟用 Singularity NVIDIA 支持
                clusterOptions   = '--gres=gpu:1' // 向 SLURM 申請 1 張 GPU
                accelerator      = 1
                cpus             = 8
                memory           = '48 GB'
                time             = '8h'
            }
        }
    }
}

